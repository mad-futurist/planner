APP_ENV=production
PUBLIC_HOST=planner.example.com
PUBLIC_BASE_URL=https://planner.example.com
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_OWNER_PASSWORD
RUNTIME_DB_PASSWORD=REPLACE_WITH_DIFFERENT_RUNTIME_PASSWORD
MIGRATION_DATABASE_URL=postgresql+psycopg://planner:URL_ENCODED_OWNER_PASSWORD@db:5432/planner
RUNTIME_DATABASE_URL=postgresql+psycopg://planner_runtime:URL_ENCODED_RUNTIME_PASSWORD@db:5432/planner
AUTH_RATE_LIMIT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_FROM=noreply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_RESPONSE_FORMAT=auto
AI_DAILY_REQUEST_LIMIT=100
WORKER_CONCURRENCY=2
