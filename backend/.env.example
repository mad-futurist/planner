DATABASE_URL=postgresql+psycopg://planner:planner@127.0.0.1:5432/planner
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_RESPONSE_FORMAT=auto
WORKER_CONCURRENCY=2
MAX_JOB_ATTEMPTS=5
AI_DAILY_REQUEST_LIMIT=100

# Public accounts (leave SMTP/Google empty for local invitation-only development)
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8000
AUTH_RATE_LIMIT_SECRET=development-only-change-for-production
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
